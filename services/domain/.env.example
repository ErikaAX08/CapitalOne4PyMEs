# Connection to the movements database. Tiger Cloud gives you this string when
# you create the service; the name is the one Tiger Data's own Go guide uses.
# Values belong in your environment, never in the repository.
#
#   postgres://<user>:<password>@<host>.<region>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
#
# Leave it unset to run without persistence: every other route still works and
# /v1/movements answers 503 rather than pretending to store anything.
DATABASE_CONNECTION_STRING=

# Optional overrides; all of them have working defaults.
# DOMAIN_ADDR=:8080
# DOMAIN_CUTOFF_DATE=2026-09-12
# DOMAIN_ENGINE_TIMEOUT_SECONDS=10
