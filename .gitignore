# Dependencies and package-manager state
node_modules/
.pnpm-store/
.npm/
.yarn/

# Build and coverage output
dist/
coverage/
*.tsbuildinfo

# Test artifacts
test-results/
playwright-report/
blob-report/

# Local configuration and secrets
.env
.env.*
!.env.example
*.local

# Tool caches and logs
.cache/
.vite/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor and operating-system files
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# This repository standardizes on pnpm. pnpm-lock.yaml stays versioned.
package-lock.json
yarn.lock

# Claude Code local session state
.claude/

# Go build output
services/domain/bin/
services/domain/**/*.test

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.lock.hcl

# Terraform configuration that is environment-specific or carries a bucket name.
# *.tfvars may hold a connection string, so it never gets committed.
backend.hcl
*.tfvars
!*.tfvars.example

# Build artifacts for Lambda packaging
**/build/
*.zip
